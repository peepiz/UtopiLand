[gd_scene format=3 uid="uid://dtl2i25e6uwmr"]

[sub_resource type="GDScript" id="GDScript_f2vk6"]
script/source = "extends Control

signal object_type_changed(new_type: int)

@onready var label = $Label

# 🎯 НОВЫЙ СТРОГИЙ ПОРЯДОК: Куб (0), Конус (1), Шар (2), Плейн (3)
var options = [\"CUBE\", \"CONE\", \"BALL\", \"PLANE\"]
var current_selection = 0

func _process(_delta):
	if !visible: return
	
	var center = Vector2(get_viewport().size) / 2
	var mouse_pos = get_viewport().get_mouse_position()
	var direction = mouse_pos - center
	
	if direction.length() < 50:
		label.text = \"CHOOSE\"
		return

	var angle = rad_to_deg(direction.angle())
	var adjusted_angle = fmod(angle + 180.0, 360.0)
	
	var new_selection = int(adjusted_angle / 90.0)
	
	if new_selection > 3:
		new_selection = 3
	
	if new_selection != current_selection:
		current_selection = new_selection
		object_type_changed.emit(current_selection)
	
	label.text = options[current_selection]
	queue_redraw()

func _draw():
	var center = Vector2.ZERO
	draw_circle(center, 150, Color(0, 0, 0, 0.5))
	
	var start_angle = deg_to_rad(current_selection * 90.0 - 180.0)
	var end_angle = deg_to_rad((current_selection + 1) * 90.0 - 180.0)
	draw_arc(center, 155, start_angle, end_angle, 64, Color.ORANGE_RED, 5.0)
"

