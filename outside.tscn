[sub_resource type="ShaderMaterial" id="ShaderMaterial_xlpbk"]
shader = ExtResource("8_0b51g")
shader_parameter/pixel_size = 4

[sub_resource type="GDScript" id="GDScript_f2vk6"]
script/source = "extends Sprite3D

# Находим игрока. Замени \"player\" на точное имя узла твоего персонажа в сцене outside
@onready var player = get_node(\"../player\") 

func _ready() -> void:
	# Твой код рандомного спавна (оставляем)
	position.x = randf_range(0, 100)
	position.y = randf_range(0, 10) # Высота ствола, чтобы он \"рос\" из земли
	position.z = randf_range(0, 100)

func _process(_delta: float) -> void:
	if player:
		# Медленно поворачиваемся к игроку. Это мега-крипово.
		# Сначала заставляем спрайт смотреть на игрока
		look_at(player.global_position, Vector3.UP)
		# И немного корректируем, так как Sprite3D по умолчанию смотрит не туда при look_at
		rotate_y(PI)
"

